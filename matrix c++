#include <iostream>
#include <stdlib.h>
#include <time.h>
using namespace std;

void matrix(int n, int m, double a, double b, double** arr)
{
    srand((unsigned)time(0));
    for (int i = 0; i < n; i++)    // кол-во строк
        for (int j = 0; j < m; j++)     // строка
            arr[i][j] = (b - a + 1) * ((double)rand() / RAND_MAX) + a;   //добавили +1 поскольку без неё рандомные числа если от 1 до 10, то 10 не включая 
}

int main()
{
    while (true) {
        cout << "------------------------------------------------" << endl;
        setlocale(LC_ALL, "Russian");
        double a, b;
        double** p; // создали указатель на указатель
        int n, m, i, j, k;


        cout << "Введите количество строк матрицы: "; cin >> n;
        cout << "Введите количество столбцов матрицы: "; cin >> m;
        if ( 7 <= m && m <= 17 || 7 <= n && n <= 15) {
             
             

            cout << "Введите диапазон значений матрицы: "; cin >> a >> b;

            p = new double* [n]; // Создание вспомогательного массива указателей (т.е. массив в динамической памяти, кот. состоит из указателей
            //каждый элемент массива-указатель
            //Формируем одномерные массивы из строк матрицы

            for (i = 0; i < n; i++)
            {
                p[i] = new double[m]; //инициализация указателей, из кот. состоит массив
            }
            matrix(n, m, a, b, p);   //добавляем функцию
            cout << "       Сформирована матрица:" << endl;
            cout << endl;
            for (i = 0; i < n; i++) {
                for (j = 0; j < m; j++) cout << '\t' << p[i][j];  // \t-табуляция 
                cout << endl;
            }
            cout << endl;
            cout << "Указанный диапазон: " << "[" << a + (b - a) / 8 << "; " << b - (b - a) / 8 << "]" << endl;

            int nomer = 0;     //номер элемента столбца
            for (j = 0; j < m; j++)     //i,n кол-во строк(ширина матрицы)
            {
                for (i = 0; i < n; i++)    //j, m кол-во столбиков(длина)
                {
                    if (p[i][j] >= (a + (b - a) / 8) && p[i][j] <= (b - (b - a) / 8))
                    {
                        nomer++;
                         if ((j = m - 1) && nomer == 0) cout << "Таких столбцов нет";
                         nomer = 0;
                    }

                }
                if (nomer >= 3 && nomer <= 4)  //если уже набралось 3-4 элемента, выводим фразу
                {
                    cout << "В " << j + 1 << "-ом столбце: " << nomer << " числа находятся в указанном диапазоне." << endl;
                    nomer = 0;
                }
                //else cout << "В " << j + 1 << "-ом столбце нет чисел в диапазоне." << endl;

                     if ((j = m - 1) && nomer == 0) cout << "Таких столбцов нет";
                nomer = 0;
            }


            //Важный момент: ранее мы создавали матрицу в динамической памяти. Сейчас нам необходимо её удалить.
            //Для этого мы делаем так:
            // 1)удаляем матрицу из динамической памяти
            // 2)удаляем массив указателей из этой же памяти

            for (i = 0; i < n; i++) {
                delete[] p[i]; // Удаляем строки матрицы
            }

            delete[] p;  // Удаление вспомогательного массива указателей
        }
        else {
            do
            {
                cout << "ERROR! Введите корректное число строк и столбцов! " << endl;
                cout << "Введите количество строк матрицы: "; cin >> n;
                cout << "Введите количество столбцов матрицы: "; cin >> m;
            } while (7 <= m && m <= 17 || 7 <= n && n <= 15);
        }
    }
    return 0;
}
