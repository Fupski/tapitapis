import java.util.Scanner;

public class Main {

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        int sum = 0;

        int n;
        do {
            n = scanner.nextInt(); 
            sum = sum + n;
            System.out.println(sum);
        } while (n > 0);


        System.out.println("Введен 0 ");
        System.out.print("The end :^");
    }
        }
