    {
        patient.Procedures.Add(procedure);
        nurse.DoProcedure(patient);
        // записать процедуру в карту пациента
    }

    public void AssignDiagnosis(Patient patient, Doctor doctor, string diagnosis)
    {
        patient.Diagnoses.Add(diagnosis);
