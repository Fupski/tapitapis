#include <iostream>
#include <string>
using namespace std;

struct Student {
    string surname;
    string name;
    string patronymic;
    char gender;
    int age;
    int course;
    double gpa;
};

int main() {
    const int MAX_STUDENTS = 100;
    Student students[MAX_STUDENTS];
    int numStudents;
    double totalGpa = 0;
    int numMales = 0;

    cout << "Enter the number of students: ";
    cin >> numStudents;

    for (int i = 0; i < numStudents; i++) {
        cout << "Student #" << i+1 << endl;
        cout << "Surname: ";
        cin >> students[i].surname;
        cout << "Name: ";
        cin >> students[i].name;
        cout << "Patronymic: ";
        cin >> students[i].patronymic;
        cout << "Gender (M/F): ";
        cin >> students[i].gender;
        cout << "Age: ";
        cin >> students[i].age;
        cout << "Course: ";
        cin >> students[i].course;
        cout << "GPA: ";
        cin >> students[i].gpa;

        totalGpa += students[i].gpa;

        if (students[i].gender == 'M' && students[i].course == numStudents) {
            if (students[i].gpa < totalGpa/numStudents) {
                numMales++;
            }
        }
    }

    cout << "Number of male students on course " << numStudents << " with GPA below average: " << numMales << endl;

    return 0;
}



























